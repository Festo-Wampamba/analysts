# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database -----------------------------------------------------------
# For local development, start a project-specific Postgres instance and map
# it to port 5433, or replace this with the target Neon connection string.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/analysts

# --- Finnhub (market data) -----------------------------------------------
# Free tier, 60 req/min. Register: https://finnhub.io/register
# Key location after signup: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# --- SEC EDGAR (primary filing data) -------------------------------------
# The SEC requires an identifying User-Agent containing an app/company name
# and a monitored contact address.
SEC_USER_AGENT=Analysts Research contact@example.com

# --- Twelve Data (primary intraday chart provider) ------------------------
# Basic free plan; this app caches 1D bars for five minutes.
# Register: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# --- Alpha Vantage (optional daily/weekly chart fallback) -----------------
# Free allowance is small; the app reserves headroom with a lower daily cap.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_BUDGET=20

# --- Groq (LLM narrative generation) -------------------------------------
# Free tier console. Register: https://console.groq.com
# Key location: https://console.groq.com/keys
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b if unset. The app remaps the
# retired llama-3.3-70b-versatile setting automatically, but update deployed
# environment values to this supported model too.
GROQ_MODEL=openai/gpt-oss-120b

# --- Resend (daily idea email delivery) ----------------------------------
# Register: https://resend.com/signup
# Key location: https://resend.com/api-keys
# FROM must be on a domain verified in Resend (Domains tab); TO is a
# comma-separated recipient list.
RESEND_API_KEY=
DAILY_IDEA_FROM=
DAILY_IDEA_TO=

# --- Screen cron auth ------------------------------------------------------
# Bearer token the GitHub Actions workflow sends to POST /api/screen.
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Build metadata (set by CI/Docker, not local dev) --------------------
BUILD_SHA=
